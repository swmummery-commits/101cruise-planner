# Base44 Finder — local env template for ship lookup
# Copy to .env in the repo root (never commit .env).
# CRM booking uses separate variables — do not put CRM keys here.

BASE44_FINDER_APP_ID=
BASE44_FINDER_API_KEY=

# Supabase — required for Cruise Intelligence import script and Netlify functions.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser / Squarespace code.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (required for DDL migrations only — never expose to browser):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional — Cruise Finder destination hero images (Unsplash preferred when set).
# Without this key, destination-hero falls back to Openverse (royalty-free).
# UNSPLASH_ACCESS_KEY=

# Required for Cruise Finder live sailing search (Netlify Functions only — never expose to the browser).
# Create a key at https://api-dashboard.search.brave.com/
# BRAVE_SEARCH_API_KEY=

# Optional — Port Image Finder (Pexels). Wikimedia Commons and Brave use BRAVE_SEARCH_API_KEY above.
# PEXELS_API_KEY=

# Sprint 14A — Cruise Finder Engine flag (server-side only).
# Default v1 keeps the existing Discovery-catalogue customer path.
# v2 is prepared but NOT activated in Phase 1 (HOLD DEPLOY).
# CRUISE_FINDER_ENGINE=v1

# OpenAI — required for Sprint 10D Research Content generation (and Admin itinerary extract).
# Add this in Netlify Site settings → Environment variables (server-only; never expose to the browser).
# OPENAI_API_KEY=
# Optional model override (defaults to gpt-4.1-mini):
# OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# OPENAI_ITINERARY_MODEL=gpt-4.1-mini

# Optional — itinerary exception email alerts (Resend).
# Leave unset to keep Admin Needs Attention queue only (recommended until needed).
# Free tier: $0 setup, $0/mo, 3,000 emails/month, 100/day. Recipients are
# admin_users.notify_itinerary_exceptions=true — never hardcode personal emails.
# RESEND_API_KEY=
# ITINERARY_ALERT_FROM_EMAIL=alerts@your-verified-domain

# Mailchimp File Manager — required for newsletter HTML export.
# Images are copied from Supabase into folder "101cruise Newsletter Images"
# and the exported HTML uses those Mailchimp URLs (never Supabase).
# Create a key at Mailchimp → Account → Extras → API keys (the key ends with -<dc>, e.g. us21).
# MAILCHIMP_API_KEY=
# Optional if the key has no datacentre suffix:
# MAILCHIMP_SERVER_PREFIX=us21
# Optional folder title override (default: 101cruise Newsletter Images):
# MAILCHIMP_NEWSLETTER_FOLDER_NAME=101cruise Newsletter Images

TRACK_CRUISES_RAPIDAPI_KEY=
TRACK_CRUISES_RAPIDAPI_HOST=cruise-pricing-api1.p.rapidapi.com

# Sprint 16A — Canonical inventory writer target.
# Default is local SQLite DEV DB (tmp/dev-inventory/) and NEVER production Supabase.
# INVENTORY_DB_TARGET=sqlite-dev

# Cruise Discovery automation hold controls (server-side; default false).
# CRUISE_DISCOVERY_AUTOMATION_ENABLED=false
# CRUISE_DISCOVERY_EXPIRE_SAILED_ENABLED=false
# HAL line-specific (do not enable general cron):
# HAL_DISCOVERY_WRITE_ENABLED=false
# HAL_AUTOMATIC_CONTINUATION_ENABLED=false
# Future line-specific (code-only defaults false until approved):
# PRINCESS_DISCOVERY_WRITE_ENABLED=false
# PRINCESS_AUTOMATIC_CONTINUATION_ENABLED=false
# CELEBRITY_DISCOVERY_WRITE_ENABLED=false
# CELEBRITY_AUTOMATIC_CONTINUATION_ENABLED=false
# DISCOVERY_CRON_SECRET= (required only when automation enabled)
# Optional future dedicated non-production Supabase (do not set to the live project):
# SUPABASE_DEV_URL=
# SUPABASE_DEV_SERVICE_ROLE_KEY=
