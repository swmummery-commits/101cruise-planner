.DS_Store

# Dependencies
node_modules/

# Local env / secrets — never commit credentials
.env
.env.*
!.env.example
.netlify/

# Logs / OS
*.log
npm-debug.log*

# Local route-map SVG previews (Sprint 13E Phase 3A)
tmp/
tmp/route-map-previews/

# Generated Featured Cruise route maps (Sprint 13E Phase 4)
# Contents ignored via generated-assets/.gitignore; keep folder with .gitkeep
generated-assets/*
!generated-assets/.gitignore
!generated-assets/.gitkeep

# Generated Discovery departure remediation manifests (dry-run / apply output)
reports/departure-remediation-*.json
reports/departure-remediation-rollback-*.json
reports/non-sailing-purge-*.json
reports/review-queue-audit-*.json
reports/discovery-automation-dry-run-*.json
reports/discovery-review-reconciliation*.json
reports/operational-destination-backup-*.json
reports/operational-destination-seed-apply-*.json
reports/operational-destination-seed-rollback-*.json
reports/destination-correction-deterministic-*.json
reports/destination-correction-rollback-*.json
